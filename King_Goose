    function generateQuestionByNumber(num1Based) {
        const idx = ((num1Based - 1) % TOTAL_QUESTION_BANK_SIZE + TOTAL_QUESTION_BANK_SIZE) % TOTAL_QUESTION_BANK_SIZE;
        const qNum = idx + 1;
        const tpl = multiSubjectTemplates[qNum % multiSubjectTemplates.length];
        return tpl.build(qNum);
    }

    function getDayIndexSinceEpoch() {
        const now = new Date();
        const utcMidnightToday = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        return Math.floor(utcMidnightToday / 86400000);
    }

    let todayQuestionPool = [];
    let activeDailyStartNum = 1;

    function buildDaily300Pool(startNum1Based) {
        const pool = [];
        for (let i = 0; i < DAILY_QUESTION_BATCH_SIZE; i++) {
            const num = ((startNum1Based - 1 + i) % TOTAL_QUESTION_BANK_SIZE) + 1;
            pool.push(generateQuestionByNumber(num));
        }
        if (customUploadedQuestions.length > 0) {
            customUploadedQuestions.forEach(cq => pool.push(cq));
        }
        return pool;
    }

    function refreshDailyQuestionPool() {
        const dayIdx = getDayIndexSinceEpoch();
        activeDailyStartNum = ((dayIdx * DAILY_QUESTION_BATCH_SIZE) % TOTAL_QUESTION_BANK_SIZE) + 1;
        todayQuestionPool = buildDaily300Pool(activeDailyStartNum);

        const infoEl = document.getElementById("daily-question-pool-info");
