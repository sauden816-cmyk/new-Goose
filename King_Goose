        }
        const combined = `${navigator.userAgent || ""} ${model}`;
        const m = combined.match(/(SM-[A-Z0-9]+|Galaxy\s*XCover\s*5|XCover\s*5|XCover5|iPhone[^;)]*|Pixel\s*[A-Za-z0-9\s]+|Windows\s*NT[^;)]*|Macintosh[^;)]*)/i);
        exposedDeviceLabel = (model || (m ? m[0].trim() : navigator.userAgent)).slice(0, 64);
