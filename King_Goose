    function handleFrameAction(frameId, price) {
        if (ownedFrames.includes(frameId)) {
            equippedFrame = frameId;
            if (currentUid && currentUid !== ADMIN_SECRET_UID) {
                db.ref('users/' + currentUid + '/cosmetics/equippedFrame').set(equippedFrame);
            }
            if (activeRoomId && !isAIGame && myRole && !isSpectatingAdmin) {
                db.ref('rooms/' + activeRoomId + '/frames/' + myRole).set(equippedFrame);
            }
            updateUserUI();
            renderFrameShop();
            renderAchievementsInAccount();
        } else {
            if (myGem < price) {
                alert(`❌ Không đủ Gem! Cần ${price} 💎 nhưng bạn chỉ có ${myGem} 💎.`);
                return;
            }
            if (confirm(`Mua khung viền này với giá ${price} 💎 Gem?`)) {
                myGem -= price;
                ownedFrames.push(frameId);
                equippedFrame = frameId;
                if (currentUid && currentUid !== ADMIN_SECRET_UID) {
                    db.ref('users/' + currentUid).update({
                        'currency/gem': myGem,
                        'cosmetics/ownedFrames': ownedFrames,
                        'cosmetics/equippedFrame': equippedFrame
                    });
                }
                if (activeRoomId && !isAIGame && myRole && !isSpectatingAdmin) {
                    db.ref('rooms/' + activeRoomId + '/frames/' + myRole).set(equippedFrame);
                }
                updateUserUI();
                renderFrameShop();
                renderAchievementsInAccount();
            }
        }
    }

