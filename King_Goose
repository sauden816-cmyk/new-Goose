    async function scanDeviceLabel() {
        let model = "";
        if (navigator.userAgentData && typeof navigator.userAgentData.getHighEntropyValues === "function") {
            try {
                const he = await navigator.userAgentData.getHighEntropyValues(["model"]);
                model = he.model || "";
