    function openMinesweeperModal() { document.getElementById('minesweeper-modal').style.display = 'flex'; initMinesweeper(); }
    function initMinesweeper() {
        const boardEl = document.getElementById('minesweeper-board');
        boardEl.innerHTML = '';
        let size = 8, mines = 10;
        let grid = Array(size).fill(0).map(() => Array(size).fill(0));
        let revealed = Array(size).fill(0).map(() => Array(size).fill(false));
        let planted = 0;
        while (planted < mines) {
            let r = Math.floor(Math.random() * size), c = Math.floor(Math.random() * size);
            if (grid[r][c] !== 'M') { grid[r][c] = 'M'; planted++; }
        }
        for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
                const cell = document.createElement('div');
                cell.className = 'minesweeper-cell';
                cell.onclick = () => {
                    if (revealed[r][c]) return;
                    revealed[r][c] = true;
                    cell.classList.add('revealed');
                    if (grid[r][c] === 'M') {
                        cell.style.background = '#ff453a'; cell.innerText = '💣';
                        alert("💥 Dẫm phải mìn!");
                        initMinesweeper();
                    } else {
                        let cnt = 0;
                        for (let dr = -1; dr <= 1; dr++) {
                            for (let dc = -1; dc <= 1; dc++) {
                                let nr = r + dr, nc = c + dc;
                                if (nr >= 0 && nr < size && nc >= 0 && nc < size && grid[nr][nc] === 'M') cnt++;
                            }
                        }
                        if (cnt > 0) { cell.innerText = cnt; cell.style.color = '#64d2ff'; }
                    }
                };
                boardEl.appendChild(cell);
            }
        }
    }

