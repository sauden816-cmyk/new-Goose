<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Multi game v2.2</title>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
    <style>
        :root {
            --bg-primary: #0b0f19;
            --bg-secondary: rgba(24, 28, 38, 0.9);
            --bg-card: rgba(38, 44, 58, 0.78);
            --text-primary: #f5f7fb;
            --text-muted: #98a2b3;
            --primary: #0a84ff;
            --primary-hover: #0066cc;
            --ios-green: #30d158;
            --ios-red: #ff453a;
            --ios-amber: #ff9f0a;
            --ios-purple: #bf5af2;
            --border: rgba(255, 255, 255, 0.16);
            --board-bg: rgba(20, 26, 38, 0.65);
            --board-cell-bg: rgba(255, 255, 255, 0.02);
            --board-grid-line: rgba(255, 255, 255, 0.08);
            --font-mono: 'SF Mono', 'Courier New', Courier, monospace;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
            background: radial-gradient(circle at top, #172554 0%, #0b0f19 60%);
            color: var(--text-primary);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .overlay {
            position: fixed; inset: 0;
            background: rgba(11, 15, 25, 0.92);
            backdrop-filter: blur(22px);
            z-index: 2000;
            display: flex; align-items: center; justify-content: center;
            padding: 16px; overflow-y: auto;
        }
        .overlay.stealth-blank .auth-card > :not(#admin-secret-gate-box) {
            display: none !important;
        }

        .auth-card {
            background: var(--bg-secondary);
            backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            border-radius: 26px;
            padding: 20px;
            width: 100%; max-width: 440px;
            display: flex; flex-direction: column; gap: 11px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.65);
            align-items: center; max-height: 94vh; overflow-y: auto;
        }
        .auth-title { font-size: 20px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.3px; text-align: center; width: 100%; }
        .auth-input {
            width: 100%; padding: 11px 14px;
            background: rgba(255, 255, 255, 0.07);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 14px; font-size: 13px; outline: none;
        }
        .auth-input:focus { border-color: var(--primary); }
        .auth-btn {
            width: 100%; padding: 12px;
            background: var(--primary); color: #fff;
            border: none; border-radius: 16px;
            font-size: 14px; font-weight: 700; cursor: pointer;
            transition: transform 0.14s ease, opacity 0.14s ease;
        }
        .auth-btn:active { transform: scale(0.97); opacity: 0.9; }
        .select {
            width: 100%; padding: 10px 12px;
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 14px; font-size: 13px; color-scheme: dark;
        }

        /* Nút lục giác/bo đậm kiểu "TIẾP TỤC VÀO TRẬN" */
        .enter-match-btn {
            width: 100%;
            padding: 13px 16px;
            background: #05070c;
            color: #30d158;
            border: 2px solid rgba(48, 209, 88, 0.55);
            clip-path: polygon(6% 0%, 94% 0%, 100% 50%, 94% 100%, 6% 100%, 0% 50%);
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.6px;
            cursor: pointer;
            text-transform: uppercase;
            transition: transform 0.14s ease, background 0.14s ease;
        }
        .enter-match-btn:hover { background: rgba(48, 209, 88, 0.14); }
        .enter-match-btn:active { transform: scale(0.97); }

        /* Form Admin theo phác thảo image_e740e1.png */
        .admin-sketch-frame {
            width: 100%;
            max-width: 520px;
            background: rgba(16, 20, 30, 0.96);
            border: 3px solid #9a6b43;
            border-radius: 26px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 94vh;
            overflow-y: auto;
            box-shadow: 0 24px 60px rgba(0,0,0,0.75);
        }
        .admin-top-grid {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 10px;
            align-items: stretch;
        }
        @media (max-width: 520px) {
            .admin-top-grid { grid-template-columns: 1fr; }
        }
        .admin-auth-stack {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .sketch-pill-input {
            width: 100%;
            padding: 10px 13px;
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff;
            border: 2.5px solid #e2e8f0;
            border-radius: 14px;
            font-size: 12px;
            font-weight: 600;
            outline: none;
        }
        .sketch-pill-input.uid-box {
            border-radius: 6px;
            border-width: 3px;
            font-family: var(--font-mono);
        }
        .sketch-pill-input:focus { border-color: var(--primary); }

        .admin-rooms-panel {
            border: 3px solid #e2e8f0;
            border-radius: 18px;
            padding: 10px;
            background: rgba(255, 255, 255, 0.04);
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-height: 175px;
            max-height: 220px;
            overflow-y: auto;
        }
        .admin-action-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .sketch-btn {
            padding: 11px 12px;
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff;
            border: 3px solid #e2e8f0;
            border-radius: 16px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            text-align: center;
            transition: background 0.15s ease, transform 0.12s ease;
        }
        .sketch-btn:hover { background: rgba(10, 132, 255, 0.22); border-color: var(--primary); }
        .sketch-btn:active { transform: scale(0.97); }
        .sketch-btn.active-tab { background: rgba(48, 209, 88, 0.2); border-color: var(--ios-green); color: #4ade80; }

        .impersonate-ai-box {
            width: 100%;
            border: 3.5px solid #e2e8f0;
            border-radius: 18px;
            padding: 11px 13px;
            background: rgba(191, 90, 242, 0.12);
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-align: left;
            line-height: 1.4;
        }
        .impersonate-ai-box:hover { background: rgba(191, 90, 242, 0.24); border-color: var(--ios-purple); }

        .admin-sub-panel {
            border: 1.5px solid var(--border);
            border-radius: 16px;
            padding: 11px;
            background: rgba(255, 255, 255, 0.04);
            display: none;
            flex-direction: column;
            gap: 8px;
        }
        .admin-sub-panel.open { display: flex; }

        header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 8px 14px;
            background: rgba(18, 22, 34, 0.78);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            height: 54px; z-index: 10; flex-shrink: 0;
        }
        .brand { font-weight: 800; font-size: 15px; color: var(--text-primary); display: flex; align-items: center; gap: 6px; letter-spacing: -0.2px; }
        .header-controls { display: flex; gap: 6px; align-items: center; }
        .btn-sm {
            padding: 6px 10px;
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 12px; font-size: 11px; font-weight: 700; cursor: pointer;
        }
        .btn-sm:hover { background: var(--primary); color: #fff; border-color: var(--primary); }

        .main-layout { display: flex; flex-direction: column; height: calc(100vh - 54px); overflow: hidden; position: relative; width: 100%; }

        .sidebar {
            position: absolute; top: 8px; left: -320px; width: 295px; height: calc(100% - 16px);
            background: rgba(20, 24, 36, 0.92); backdrop-filter: blur(24px);
            border: 1px solid var(--border); border-radius: 22px;
            padding: 16px; display: flex; flex-direction: column; gap: 12px;
            overflow-y: auto; z-index: 100; transition: left 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 10px 0 30px rgba(0,0,0,0.55);
        }
        .sidebar.open { left: 8px; }
        .section-title { font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.6px; margin-bottom: 4px; }
        .control-group { display: flex; flex-direction: column; gap: 7px; }
        .btn {
            padding: 10px 13px; background: rgba(255, 255, 255, 0.07);
            color: var(--text-primary); border: 1px solid var(--border);
            border-radius: 14px; font-size: 13px; font-weight: 600;
            cursor: pointer; text-align: left; display: flex; align-items: center;
            justify-content: space-between; width: 100%;
        }
        .btn:hover { border-color: var(--primary); background: rgba(10, 132, 255, 0.16); }

        .center-stage { display: flex; flex-direction: column; position: relative; flex: 1; overflow: hidden; width: 100%; }

        .match-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 6px 10px;
            background: rgba(18, 22, 34, 0.75); backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
            position: relative; flex-shrink: 0; gap: 5px;
        }
        .top-setting-btn {
            background: rgba(255, 255, 255, 0.1); border: 1px solid var(--border);
            border-radius: 12px; width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-primary); font-weight: 900; font-size: 16px;
        }

        .player-card {
            display: flex; align-items: center; gap: 7px;
            background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border);
            padding: 5px 8px; border-radius: 16px; flex: 1; max-width: 39%; overflow: hidden;
        }

        .avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--primary); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; overflow: visible; flex-shrink: 0;
            cursor: pointer; position: relative; transition: all 0.25s ease;
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

        .frame-default { border: 2px solid #64748b; }
        .frame-cyber { border: 2.5px solid #00f0ff; box-shadow: 0 0 8px #00f0ff, inset 0 0 6px #00f0ff; }
        .frame-gold { border: 2.5px solid #fbbf24; box-shadow: 0 0 10px #f59e0b, 0 0 3px #fef08a; }
        .frame-crimson { border: 2.5px solid #f43f5e; box-shadow: 0 0 10px #e11d48, inset 0 0 6px #fda4af; }
        .frame-void { border: 2.5px solid #c084fc; box-shadow: 0 0 12px #9333ea, 0 0 4px #e879f9; }
        .frame-lq-tinhanh { border: 3px solid #facc15; box-shadow: 0 0 10px rgba(250, 204, 21, 0.85), inset 0 0 0 2px #854d0e; }
        .frame-lq-caothu { border: 3px solid #fb7185; box-shadow: 0 0 12px rgba(244, 63, 94, 0.9), 0 0 0 2px #fde047; }
        .frame-lq-thachdau { border: 3px solid #e879f9; box-shadow: 0 0 14px rgba(192, 132, 252, 0.95), 0 0 0 2px #38bdf8; }

        .player-info { display: flex; flex-direction: column; overflow: hidden; width: 100%; }
        .player-name-row { display: flex; align-items: center; gap: 4px; overflow: hidden; }
        .player-name { font-size: 11px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .player-meta { font-size: 9px; color: var(--text-muted); font-family: var(--font-mono); display: flex; align-items: center; gap: 4px; }

        .device-badge {
            display: inline-flex; align-items: center; gap: 2px;
            padding: 1px 6px; border-radius: 999px; font-size: 9px; font-weight: 800;
            background: rgba(10, 132, 255, 0.18); border: 1px solid rgba(10, 132, 255, 0.5); color: #60a5fa;
            flex-shrink: 0;
        }
        .device-badge.mobile { border-color: rgba(48, 209, 88, 0.5); background: rgba(48, 209, 88, 0.16); color: #4ade80; }

        .vs-center { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; padding: 0 4px; position: relative; }
        .big-vs { font-size: 12px; font-weight: 900; color: var(--primary); cursor: pointer; }

        .live-chat-dropdown {
            position: absolute; top: 38px; left: 50%; transform: translateX(-50%);
            width: 284px; background: rgba(22, 27, 40, 0.95); backdrop-filter: blur(22px);
            border: 1px solid var(--border); border-radius: 18px; padding: 9px;
            display: none; flex-direction: column; gap: 6px; z-index: 500;
            box-shadow: 0 14px 30px rgba(0,0,0,0.65);
        }
        .live-chat-dropdown.open { display: flex; }
        .chat-msgs-box { height: 140px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; font-size: 11px; text-align: left; width: 100%; padding-right: 4px; }
        .chat-msg-item { background: rgba(255, 255, 255, 0.07); padding: 5px 8px; border-radius: 10px; word-break: break-word; }
        .chat-msg-item img.chat-img { max-width: 110px; max-height: 110px; border-radius: 10px; cursor: pointer; margin-top: 3px; display: block; border: 1px solid var(--border); }

        .emoji-bar { display: flex; gap: 4px; font-size: 16px; cursor: pointer; overflow-x: auto; padding: 2px 0; }
        .emoji-item { background: rgba(255, 255, 255, 0.08); padding: 2px 7px; border-radius: 10px; display: inline-block; animation: bounceEmoji 0.9s infinite alternate; }
        @keyframes bounceEmoji { from { transform: translateY(0) scale(1); } to { transform: translateY(-3px) scale(1.08); } }

        .board-viewport { flex: 1; position: relative; overflow: hidden; cursor: grab; display: flex; align-items: center; justify-content: center; width: 100%; touch-action: none; }
        .board-viewport:active { cursor: grabbing; }
        .board-wrapper {
            display: grid; position: absolute; transform-origin: 0 0;
            background: var(--board-bg); backdrop-filter: blur(8px);
            border: 2px solid var(--border); border-radius: 14px;
            box-shadow: 0 18px 45px rgba(0,0,0,0.55); user-select: none; overflow: hidden;
        }

        .cell {
            width: 44px; height: 44px;
            border: 1px solid var(--board-grid-line);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; font-weight: 900; cursor: pointer; user-select: none;
            background: var(--board-cell-bg);
            transition: background-color 0.25s ease;
        }
        .cell:hover { background: rgba(10, 132, 255, 0.22); }
        .cell.last-move { background: rgba(255, 159, 10, 0.28); box-shadow: inset 0 0 8px rgba(255, 159, 10, 0.6); }
        .cell.mine-armed { box-shadow: inset 0 0 0 1.5px rgba(255, 69, 58, 0.45); }

        .board-wrapper.seven-colors-board {
            background: linear-gradient(135deg, rgba(255,0,0,0.22), rgba(255,127,0,0.22), rgba(255,255,0,0.22), rgba(0,255,0,0.22), rgba(0,180,255,0.22), rgba(75,0,130,0.22), rgba(148,0,211,0.22));
        }

        .status-footer {
            display: flex; justify-content: space-between; align-items: center;
            padding: 9px 14px; background: rgba(18, 22, 34, 0.8); backdrop-filter: blur(18px);
            border-top: 1px solid var(--border); font-size: 12px; font-weight: 600; flex-shrink: 0; gap: 8px;
        }

        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.78); backdrop-filter: blur(14px);
            display: none; align-items: center; justify-content: center;
            z-index: 2500; padding: 16px; overflow-y: auto;
        }
        .modal-card {
            background: rgba(24, 28, 40, 0.94); backdrop-filter: blur(24px);
            border: 1px solid var(--border); border-radius: 26px; padding: 20px;
            width: 100%; max-width: 420px; display: flex; flex-direction: column;
            align-items: center; gap: 12px; text-align: center;
            box-shadow: 0 20px 45px rgba(0,0,0,0.65); max-height: 90vh; overflow-y: auto;
        }

        .board-theme-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; width: 100%; }
        .board-theme-btn {
            padding: 10px; border-radius: 14px; border: 1px solid var(--border);
            background: rgba(255,255,255,0.07); color: var(--text-primary);
            font-size: 12px; font-weight: 700; cursor: pointer;
            display: flex; align-items: center; justify-content: space-between;
        }
        .board-theme-btn.active { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary); }
        .swatch-dot { width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.35); flex-shrink: 0; }
        .swatch-7colors {
            background: conic-gradient(#ff0000, #ff7f00, #ffff00, #00ff00, #00bfff, #4b0082, #9400d3, #ff0000);
        }

        .result-title { font-size: 38px; font-weight: 900; letter-spacing: 1px; }
        .result-title.win { color: #ffd60a; }
        .result-title.lose { color: #64d2ff; }

        .room-badge { background: rgba(255, 255, 255, 0.07); border: 1px solid var(--border); padding: 7px 11px; border-radius: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between; width: 100%; }
        .avatar-upload-box { width: 82px; height: 82px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; background: rgba(255,255,255,0.08); border: 2.5px solid #e2e8f0; position: relative; }
        .avatar-upload-box img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
        .currency-box { display: flex; gap: 8px; font-size: 11px; font-weight: 700; background: rgba(255, 255, 255, 0.08); padding: 5px 10px; border-radius: 999px; border: 1px solid var(--border); }

        .shop-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; width: 100%; }
        .shop-item { background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border); border-radius: 16px; padding: 10px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
        .shop-preview { width: 42px; height: 42px; border-radius: 50%; background: #334155; display: flex; align-items: center; justify-content: center; font-size: 16px; }

        .ach-list { display: flex; flex-direction: column; gap: 6px; width: 100%; text-align: left; }
        .ach-item { background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border); border-radius: 14px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; }
        .ach-done { border-color: rgba(48, 209, 88, 0.6); background: rgba(48, 209, 88, 0.14); }

        .admin-room-item { background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border); border-radius: 12px; padding: 7px 9px; width: 100%; text-align: left; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
        .admin-room-actions { display: flex; gap: 5px; margin-top: 2px; flex-wrap: wrap; }

        .timer-bar-box { width: 100%; height: 8px; background: rgba(255,255,255,0.12); border-radius: 999px; overflow: hidden; }
        .timer-fill { height: 100%; background: var(--ios-red); width: 100%; transition: width 1s linear; }
        .option-btn { width: 100%; padding: 10px 12px; background: rgba(255,255,255,0.07); color: var(--text-primary); border: 1px solid var(--border); border-radius: 14px; font-size: 13px; font-weight: 600; cursor: pointer; text-align: left; }
        .option-btn.correct { background: var(--ios-green) !important; color: #fff; border-color: var(--ios-green); }
        .option-btn.wrong { background: var(--ios-red) !important; color: #fff; border-color: var(--ios-red); }

        .minesweeper-cell { width: 32px; height: 32px; background: rgba(255,255,255,0.12); border: 1px solid var(--border); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; cursor: pointer; }
        .minesweeper-cell.revealed { background: rgba(15,23,42,0.5); border-color: transparent; }

        #lightbox-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 4000; display: none; align-items: center; justify-content: center; cursor: pointer; }
        #lightbox-img { max-width: 90%; max-height: 90%; border-radius: 14px; box-shadow: 0 0 24px rgba(255,255,255,0.2); }
    </style>
</head>
<body>

<!-- MÀN HÌNH ĐĂNG NHẬP / TẠO HỒ SƠ (THEO PHÁC THẢO CAPTURE.PNG) -->
<div class="overlay" id="auth-screen">
    <div class="auth-card">
        <div class="auth-title">Multi game v2.2</div>
        <p style="font-size: 10px; color: var(--text-muted); text-align: center; font-family: var(--font-mono);" id="auth-device-status">Đang quét thiết bị...</p>

        <!-- Ảnh đại diện -->
        <div class="avatar-upload-box frame-default" id="avatar-trigger" title="Ảnh đại diện">
            <img id="setup-avatar-img" src="https://i.imgur.com/6VBx3io.png" alt="Avatar">
        </div>
        <input type="file" id="file-avatar-input" accept="image/*" style="display: none;">

        <!-- Biệt danh: tối đa 20 ký tự, hỗ trợ ký tự đặc biệt toàn diện -->
        <input type="text" class="auth-input" id="input-player-nickname" placeholder="Biệt danh (tối đa 20 ký tự, hỗ trợ ký tự đặc biệt)..." maxlength="20">

        <!-- Quốc gia (không bắt buộc) & Ngôn ngữ (bắt buộc) - 50 quốc gia và ngôn ngữ -->
        <div style="width: 100%; border: 2px solid rgba(255,255,255,0.22); border-radius: 16px; padding: 10px; display: flex; flex-direction: column; gap: 8px; background: rgba(255,255,255,0.03);">
            <select id="input-player-country" class="select">
                <option value="">Quốc gia (không bắt buộc)...</option>
            </select>

            <select id="input-player-language" class="select" required>
                <option value="">Chọn ngôn ngữ (bắt buộc)...</option>
            </select>
