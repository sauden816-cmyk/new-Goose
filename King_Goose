        document.getElementById('country-x').innerText = countryMap[myCountry] || "";
        document.getElementById('avatar-x').className = `avatar ${equippedFrame}`;
        document.getElementById('img-avatar-x').src = myAvatar;
        document.getElementById('img-avatar-x').style.display = 'block';
        document.getElementById('txt-avatar-x').style.display = 'none';

        document.getElementById('name-o').innerText = `Bot AI (O)`;
        document.getElementById('device-badge-o').innerHTML = getDeviceBadgeHTML("PC");
        document.getElementById('device-badge-o').style.display = 'inline-flex';
        document.getElementById('country-o').innerText = "";
        document.getElementById('avatar-o').className = `avatar frame-crimson`;
        document.getElementById('img-avatar-o').style.display = 'none';
        document.getElementById('txt-avatar-o').style.display = 'flex';
        document.getElementById('txt-avatar-o').innerText = 'AI';

        statusText.innerText = "Đấu với Bot AI: Lượt của bạn!";
        initCaroBoard();
    }

    function createOnlineRoom() {
        enforceDailyEnergyReset(currentUid, myEnergy, getTodayDateKey());
        if (myEnergy < 2) {
            alert("❌ Không đủ năng lượng! Cần ít nhất 2 ⚡.");
            return;
        }

        myEnergy -= 2;
        statsData.onlineMatches += 1;
        if (currentUid && currentUid !== ADMIN_SECRET_UID) {
            db.ref('users/' + currentUid).update({
                'currency/energy': myEnergy,
                'currency/lastEnergyResetDate': getTodayDateKey(),
                'stats/onlineMatches': statsData.onlineMatches
            });
        }
        updateUserUI();

        isAIGame = false;
        isSpectatingAdmin = false;
        isImpersonatingAI = false;
        roomMinesMap = {};
        myRole = 'X';
        gameActive = true;
        activeRoomId = Math.floor(100000 + Math.random() * 900000).toString();

        const roomData = {
            createdAt: Date.now(),
            turn: 'X',
            status: 'waiting',
            hasAI: false,
            players: { X: myName, O: '' },
            countries: { X: myCountry, O: '' },
            devices: { X: myDeviceType, O: '' },
            avatars: { X: myAvatar, O: '' },
            frames: { X: equippedFrame, O: 'frame-default' },
            pieceConfig: {
                X: { icon: pieceConfig.X.icon, color: pieceConfig.X.color },
                O: { icon: pieceConfig.O.icon, color: pieceConfig.O.color }
            },
            board: Array(ROWS * COLS).fill('').join(',')
        };

        db.ref('rooms/' + activeRoomId).set(roomData, (err) => {
            if (!err) {
                document.getElementById('lobby-screen').style.display = 'none';
                document.getElementById('current-room-code-txt').innerText = activeRoomId;
                updateOnlinePlayerDisplay('X', myName, myAvatar, equippedFrame, myCountry, myDeviceType);
                statusText.innerText = `Phòng ${activeRoomId} (-2⚡) - Chờ người chơi 2...`;
                initCaroBoard();
                listenToOnlineRoom();
            }
        });
    }

    function joinOnlineRoom() {
        const code = document.getElementById('input-room-code').value.trim();
        if (!code) { alert("Nhập mã phòng!"); return; }

        db.ref('rooms/' + code).once('value', snapshot => {
            const room = snapshot.val();
            if (!room) { alert("Không tìm thấy phòng!"); return; }

            statsData.onlineMatches += 1;
            if (currentUid && currentUid !== ADMIN_SECRET_UID) {
                db.ref('users/' + currentUid + '/stats/onlineMatches').set(statsData.onlineMatches);
            }

            isAIGame = false;
            isSpectatingAdmin = false;
            isImpersonatingAI = false;
            myRole = 'O';
            gameActive = true;
            activeRoomId = code;

            db.ref('rooms/' + activeRoomId).update({
                'players/O': myName,
                'countries/O': myCountry,
                'devices/O': myDeviceType,
                'avatars/O': myAvatar,
                'frames/O': equippedFrame,
                'pieceConfig/O': { icon: pieceConfig.O.icon, color: pieceConfig.O.color },
                'status': 'playing'
            }, (err) => {
                if (!err) {
                    document.getElementById('lobby-screen').style.display = 'none';
                    document.getElementById('current-room-code-txt').innerText = activeRoomId;
                    updateOnlinePlayerDisplay('O', myName, myAvatar, equippedFrame, myCountry, myDeviceType);
                    statusText.innerText = "Đã vào phòng, trận đấu bắt đầu!";
                    initCaroBoard();
                    listenToOnlineRoom();
                }
            });
        });
    }

    function updateOnlinePlayerDisplay(role, name, avatarUrl, frameClass, countryCode, deviceType) {
        if (role === 'X') {
            document.getElementById('name-x').innerText = `${name} (X)`;
            document.getElementById('country-x').innerText = countryMap[countryCode] || "";
            if (name) {
                document.getElementById('device-badge-x').innerHTML = getDeviceBadgeHTML(deviceType);
                document.getElementById('device-badge-x').style.display = 'inline-flex';
            }
            document.getElementById('avatar-x').className = `avatar ${frameClass || 'frame-default'}`;
            if (avatarUrl) {
                document.getElementById('img-avatar-x').src = avatarUrl;
                document.getElementById('img-avatar-x').style.display = 'block';
                document.getElementById('txt-avatar-x').style.display = 'none';
            }
        } else {
            document.getElementById('name-o').innerText = name ? `${name} (O)` : "Đang đợi... (O)";
            document.getElementById('country-o').innerText = countryMap[countryCode] || "";
            if (name) {
                document.getElementById('device-badge-o').innerHTML = getDeviceBadgeHTML(deviceType);
                document.getElementById('device-badge-o').style.display = 'inline-flex';
            } else {
                document.getElementById('device-badge-o').style.display = 'none';
            }
            document.getElementById('avatar-o').className = `avatar ${frameClass || 'frame-default'}`;
            if (avatarUrl) {
                document.getElementById('img-avatar-o').src = avatarUrl;
                document.getElementById('img-avatar-o').style.display = 'block';
                document.getElementById('txt-avatar-o').style.display = 'none';
            }
        }
    }

    function copyRoomCode() { navigator.clipboard.writeText(activeRoomId).then(() => alert("Đã sao chép mã phòng!")); }

    function handleCellClick(r, c) {
        if (isSpectatingAdmin || !gameActive || board[r][c] !== '') return;
        playSound('click');

        // Kiểm tra mìn đặt trong phòng
        if (roomMinesMap[`${r},${c}`]) {
            delete roomMinesMap[`${r},${c}`];
            if (activeRoomId && !isAIGame && db) {
                db.ref(`rooms/${activeRoomId}/mines/${r},${c}`).remove();
            }
            alert(`💣 Ô (${r}, ${c}) có mìn! Bị mất 1 lượt!`);
            if (!isAIGame && activeRoomId) {
                const nextTurn = myRole === 'X' ? 'O' : 'X';
                db.ref('rooms/' + activeRoomId).update({ turn: nextTurn });
            } else if (isAIGame && !isImpersonatingAI) {
                isAITurn = true;
                setTimeout(makeMasterAIMove, 320);
            }
            refreshBoardDisplay();
            return;
        }

        // Admin đội lốt AI đánh trực tiếp
        if (isImpersonatingAI && isAIGame) {
            board[r][c] = 'O';
            lastMovePos = { r, c };
            refreshBoardDisplay();
            if (checkWin5InARow(r, c, 'O')) {
                showResultModal('win', 'Bạn (đội lốt AI) đã thắng!', '+0 💎');
                return;
            }
            statusText.innerText = "🎭 Đã đi nước của AI (O). Chờ người chơi (X)...";
            return;
        }

        if (isAIGame) {
            if (isAITurn) return;
            board[r][c] = 'X';
            lastMovePos = { r, c };
            refreshBoardDisplay();

            if (checkWin5InARow(r, c, 'X')) {
                rewardPlayer(5, true);
                showResultModal('win', 'Bạn đã thắng Bot AI!', '+5 💎 Gem');
                return;
            }

            isAITurn = true;
            statusText.innerText = "Bot AI đang đi...";
            setTimeout(makeMasterAIMove, 320);
        } else {
            db.ref('rooms/' + activeRoomId).once('value', snapshot => {
                const room = snapshot.val();
                if (!room || room.status !== 'playing') { alert("Chờ đủ người chơi!"); return; }
                if (room.turn !== myRole) { alert("Chưa tới lượt bạn!"); return; }

                board[r][c] = myRole;
                let flatBoard = board.flat().join(',');
                let nextTurn = myRole === 'X' ? 'O' : 'X';
                let win = checkWin5InARow(r, c, myRole);

                let updates = { board: flatBoard, lastMove: `${r},${c}` };
                if (win) updates.status = 'ended_' + myRole;
                else updates.turn = nextTurn;

                db.ref('rooms/' + activeRoomId).update(updates);
            });
        }
    }

    function makeMasterAIMove() {
        if (!gameActive || isImpersonatingAI) return;
        let bestScore = -Infinity, bestMove = null;

        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                if (board[r][c] === '') {
                    if (!hasNeighbor(r, c, 2)) continue;

                    let attackScore = evaluatePositionAdvanced(r, c, 'O');
                    let defendScore = evaluatePositionAdvanced(r, c, 'X');

                    let totalScore = attackScore * 1.15 + defendScore;
                    if (attackScore >= 100000) totalScore += 500000;
                    else if (defendScore >= 100000) totalScore += 250000;

                    if (totalScore > bestScore) {
                        bestScore = totalScore;
                        bestMove = { r, c };
                    }
                }
            }
        }

        if (!bestMove) bestMove = { r: Math.floor(ROWS / 2), c: Math.floor(COLS / 2) };

        let { r, c } = bestMove;
        board[r][c] = 'O';
        lastMovePos = { r, c };
        refreshBoardDisplay();
        playSound('click');

        if (checkWin5InARow(r, c, 'O')) {
            showResultModal('lose', 'Bot AI đã chiến thắng!', 'Chúc may mắn lần sau');
            return;
        }
        isAITurn = false;
        statusText.innerText = `Lượt của bạn (${myName})`;
    }

    function hasNeighbor(r, c, dist) {
        for (let dr = -dist; dr <= dist; dr++) {
            for (let dc = -dist; dc <= dist; dc++) {
                if (dr === 0 && dc === 0) continue;
                let nr = r + dr, nc = c + dc;
                if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && board[nr][nc] !== '') return true;
            }
        }
        return false;
    }

    function evaluatePositionAdvanced(r, c, player) {
        let dirs = [[0, 1], [1, 0], [1, 1], [1, -1]];
        let totalScore = 0, openThrees = 0, fourThreats = 0;
        let opponent = player === 'X' ? 'O' : 'X';

        for (let [dr, dc] of dirs) {
            let count = 1, blocked = 0, spaceJump = 0;

            let i = 1;
            while (r + dr * i >= 0 && r + dr * i < ROWS && c + dc * i >= 0 && c + dc * i < COLS) {
                let val = board[r + dr * i][c + dc * i];
                if (val === player) { count++; i++; }
                else if (val === '' && spaceJump === 0 && r + dr * (i + 1) >= 0 && r + dr * (i + 1) < ROWS && c + dc * (i + 1) >= 0 && c + dc * (i + 1) < COLS && board[r + dr * (i + 1)][c + dc * (i + 1)] === player) {
                    spaceJump = 1; i++;
                } else {
                    if (val === opponent) blocked++;
                    break;
                }
            }
            if (r + dr * i < 0 || r + dr * i >= ROWS || c + dc * i < 0 || c + dc * i >= COLS) blocked++;

            i = 1;
            while (r - dr * i >= 0 && r - dr * i < ROWS && c - dc * i >= 0 && c - dc * i < COLS) {
                let val = board[r - dr * i][c - dc * i];
                if (val === player) { count++; i++; }
                else if (val === '' && spaceJump === 0 && r - dr * (i + 1) >= 0 && r - dr * (i + 1) < ROWS && c - dc * (i + 1) >= 0 && c - dc * (i + 1) < COLS && board[r - dr * (i + 1)][c - dc * (i + 1)] === player) {
                    spaceJump = 1; i++;
                } else {
                    if (val === opponent) blocked++;
                    break;
                }
            }
            if (r - dr * i < 0 || r - dr * i >= ROWS || c - dc * i < 0 || c - dc * i >= COLS) blocked++;

            if (count >= 5 && spaceJump === 0) totalScore += 100000;
            else if (count === 4 && blocked === 0) { totalScore += 25000; fourThreats++; }
            else if (count === 4 && blocked === 1) { totalScore += 4500; fourThreats++; }
            else if (count === 3 && blocked === 0) { totalScore += 2200; openThrees++; }
            else if (count === 3 && blocked === 1) { totalScore += 300; }
            else if (count === 2 && blocked === 0) totalScore += 120;
        }

        if (openThrees >= 2) totalScore += 18000;
        if (fourThreats >= 1 && openThrees >= 1) totalScore += 30000;

        return totalScore;
    }

    function rewardPlayer(gemAmount, isWin = false) {
        myGem += gemAmount;
        if (isWin) statsData.caroWins += 1;
        if (currentUid && currentUid !== ADMIN_SECRET_UID) {
            let updates = { 'currency/gem': myGem };
            if (isWin) updates['stats/caroWins'] = statsData.caroWins;
            db.ref('users/' + currentUid).update(updates);
        }
        updateUserUI();
    }

    function startAdminTelemetryForRoom(room) {
        stopRoomTelemetryTimer();
        if (!isAdminFull || !isMobileTouchDevice()) return;

        const createdAt = room.createdAt || Date.now();
        const renderInfo = () => {
            const movesCount = (room.board || "").split(",").filter(x => x === "X" || x === "O").length;
            const elapsedSec = Math.max(0, Math.floor((Date.now() - createdAt) / 1000));
            const curTurn = room.turn || "X";
            document.getElementById('admin-room-telemetry').innerText =
                `[ADMIN] Lượt: ${curTurn} | Bước: ${movesCount} | Thời gian: ${elapsedSec}s`;
        };
        renderInfo();
        roomElapsedTimer = setInterval(renderInfo, 500);
    }

    function listenToOnlineRoom() {
        db.ref('rooms/' + activeRoomId).on('value', snapshot => {
            const room = snapshot.val();
            if (!room) {
                if (activeRoomId) {
                    alert("Phòng đã bị xóa hoặc đóng.");
                    returnToLobby();
                }
                return;
            }

            roomMinesMap = room.mines || {};

            if (isAdminFull && isMobileTouchDevice()) {
                startAdminTelemetryForRoom(room);
            }

            if (room.players) {
                if (room.players.X) {
                    updateOnlinePlayerDisplay('X', room.players.X, room.avatars?.X, room.frames?.X, room.countries?.X, room.devices?.X);
                }
                if (room.players.O) {
                    updateOnlinePlayerDisplay('O', room.players.O, room.avatars?.O, room.frames?.O, room.countries?.O, room.devices?.O);
                } else {
                    updateOnlinePlayerDisplay('O', '', '', 'frame-default', '', '');
                }
            }
            if (room.pieceConfig) {
                if (room.pieceConfig.X) pieceConfig.X = room.pieceConfig.X;
                if (room.pieceConfig.O) pieceConfig.O = room.pieceConfig.O;
            }
            if (room.lastMove) {
                let [lr, lc] = room.lastMove.split(',').map(Number);
                lastMovePos = { r: lr, c: lc };
            }

            if (room.status === 'waiting') {
                statusText.innerText = isSpectatingAdmin
                    ? `[XEM] Phòng ${activeRoomId} - Chờ O...`
                    : `Phòng ${activeRoomId} - Chờ người chơi 2...`;
            } else if (room.status === 'playing') {
                let turnName = room.turn === 'X' ? room.players.X : room.players.O;
                statusText.innerText = isSpectatingAdmin
                    ? `[XEM] Lượt: ${turnName || room.turn} (${room.turn})`
                    : `Lượt của: ${turnName} (${room.turn})`;
            } else if (room.status && room.status.startsWith('ended')) {
                let winner = room.status.split('_')[1];
                if (isSpectatingAdmin) {
                    statusText.innerText = `[XEM] Kết thúc — Thắng: ${winner}`;
                } else if (gameActive) {
                    gameActive = false;
                    let isWin = (winner === myRole);
                    if (isWin && !isImpersonatingAI) {
                        playSound('win');
                        rewardPlayer(10, true);
                    }
                    showResultModal(isWin ? 'win' : 'lose', isWin ? 'Chiến thắng!' : 'Đối thủ đã thắng!', isWin ? '+10 💎 Gem' : '+0 💎 Gem');
                }
            }

            if (room.board) {
                let arr = room.board.split(',');
                let idx = 0, sX = 0, sO = 0;
                for (let r = 0; r < ROWS; r++) {
                    for (let c = 0; c < COLS; c++) {
                        board[r][c] = arr[idx];
                        if (arr[idx] === 'X') sX++; else if (arr[idx] === 'O') sO++;
                        idx++;
                    }
                }
                refreshBoardDisplay();
                document.getElementById('score-x').innerText = `Bước: ${sX}`;
                document.getElementById('score-o').innerText = `Bước: ${sO}`;
            }
        });

        db.ref('rooms/' + activeRoomId + '/chats').on('child_added', snapshot => {
            const chat = snapshot.val();
            if (chat.type === 'text' && containsForbiddenText(chat.text || "")) {
                return;
            }
            const box = document.getElementById('chat-messages-box');
            let contentHTML = '';
            if (chat.type === 'image') {
                contentHTML = `<img src="${chat.url}" class="chat-img" onclick="openLightbox('${chat.url}')">`;
            } else {
                contentHTML = `<span>${chat.text}</span>`;
            }
            box.innerHTML += `<div class="chat-msg-item"><b>${chat.sender}:</b> ${contentHTML}</div>`;
            box.scrollTop = box.scrollHeight;
        });
    }

    function checkWin5InARow(r, c, player) {
        const dirs = [[0, 1], [1, 0], [1, 1], [1, -1]];
        for (let [dr, dc] of dirs) {
            let count = 1, i = 1;
            while (r + dr * i >= 0 && r + dr * i < ROWS && c + dc * i >= 0 && c + dc * i < COLS && board[r + dr * i][c + dc * i] === player) { count++; i++; }
            i = 1;
            while (r - dr * i >= 0 && r - dr * i < ROWS && c - dc * i >= 0 && c - dc * i < COLS && board[r - dr * i][c - dc * i] === player) { count++; i++; }
            if (count >= 5) return true;
        }
        return false;
    }

    function showResultModal(type, msg, rewardTxt) {
        const modal = document.getElementById('result-modal');
        const title = document.getElementById('result-title');
        modal.style.display = 'flex';
        title.innerText = type.toUpperCase();
        title.className = 'result-title ' + type;
        document.getElementById('result-subtitle').innerText = msg;
        document.getElementById('reward-badge').innerText = rewardTxt || '';
    }

    function restartMatch() {
        if (isSpectatingAdmin) return;
        if (isAIGame) {
            startPvEMode();
        } else if (activeRoomId) {
            db.ref('rooms/' + activeRoomId).update({
                board: Array(ROWS * COLS).fill('').join(','),
                turn: 'X',
                status: 'playing',
                lastMove: ''
            });
            document.getElementById('result-modal').style.display = 'none';
            gameActive = true;
            initCaroBoard();
        }
    }
</script>

