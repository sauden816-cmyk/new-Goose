    function normalizeVietnamese(str) {
        return str
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d").replace(/Đ/g, "D")
            .toLowerCase();
    }

    function containsForbiddenText(rawText) {
        if (!rawText) return false;
        if (rawText.includes("🖕")) return true;

        const normNoSpace = normalizeVietnamese(rawText).replace(/[^a-z0-9]/g, "");
        for (const bad of forbiddenKeywords) {
            if (normNoSpace.includes(bad)) return true;
        }

        const tokens = normalizeVietnamese(rawText).split(/[^a-z0-9]+/).filter(Boolean);
        for (const tok of tokens) {
            if (forbiddenKeywords.includes(tok)) return true;
        }

        return false;
    }

