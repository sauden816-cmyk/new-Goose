    }

    function computeStableDeviceKey() {
        const savedKey = localStorage.getItem("mg_device_hw_key");
        if (savedKey) return savedKey;

        let canvasSig = "";
        try {
            const c = document.createElement("canvas");
            const ctx = c.getContext("2d");
            ctx.textBaseline = "top";
            ctx.font = "14px Arial";
            ctx.fillText("MultiGame-v2.2-HW", 2, 2);
            canvasSig = c.toDataURL().slice(-32);
        } catch (e) {}

        const raw = [
            navigator.userAgent || "",
            navigator.platform || "",
            navigator.language || "",
            screen.width + "x" + screen.height + "x" + (screen.colorDepth || 24),
            navigator.hardwareConcurrency || 0,
            navigator.deviceMemory || 0,
            Intl.DateTimeFormat().resolvedOptions().timeZone || "",
            canvasSig
        ].join("|");

        let hash = 2166136261;
        for (let i = 0; i < raw.length; i++) {
            hash ^= raw.charCodeAt(i);
            hash = Math.imul(hash, 16777619);
        }
        const key = "DEV-" + (hash >>> 0).toString(16).toUpperCase().padStart(8, "0");
        localStorage.setItem("mg_device_hw_key", key);
        return key;
    }
